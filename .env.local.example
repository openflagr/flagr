# Copy this to .env.local (already gitignored) and edit as needed.
# Everything here is passed straight into the container's environment via
# docker-compose.yaml's env_file, and env-substituted into the compose file
# itself (build args, port mapping) when you pass --env-file .env.local.
#
# Usage:
#   docker compose --env-file .env.local up --build

# --- Build arg (Dockerfile ARG, UI entity-type restriction) ---
# FLAGR_UI_POSSIBLE_ENTITY_TYPES=null

# --- Host port mapping ---
# FLAGR_LOCAL_PORT=18000

# --- Database ---
# Leave unset to use the image's bundled sqlite demo db (zero-config, resets
# on every rebuild). To point at a real Postgres instead (e.g. the dsp-dev
# Azure Flexible Server), uncomment and fill in:
# FLAGR_DB_DBDRIVER=postgres
# FLAGR_DB_DBCONNECTIONSTR=host=<hostname>port=5432 user=<username> dbname=<dbase name> password=CHANGEME sslmode=require
# FLAGR_DB_DBCONNECTION_DEBUG=true

# --- Web prefix (matches the /feature-flags ingress path in dsp-argocd-config) ---
# FLAGR_WEB_PREFIX=/feature-flags

# --- JWT auth (Agrimetrics' group-claim patch) ---
# FLAGR_JWT_AUTH_ENABLED=true
# FLAGR_JWT_AUTH_NO_TOKEN_STATUS_CODE=401
# FLAGR_JWT_AUTH_SECRET=CHANGEME
# FLAGR_JWT_AUTH_REQUIRE_GROUP_CLAIM=g_global_admin
